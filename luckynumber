import sys
import datetime

def calculate_lucky_number(birth_date_str):

    current_sum = 0
    for digit in birth_date_str:
        if digit.isdigit():
            current_sum += int(digit)

    while current_sum > 9:
        next_sum = 0
        for digit in str(current_sum):
            next_sum += int(digit)
        current_sum = next_sum
    return current_sum

def main():

    try:
        input_data = sys.stdin.read().strip()
    except EOFError:
        print("error")
        sys.exit(1)

    extracted_digits = "".join(filter(str.isdigit, input_data))


    lucky_number = calculate_lucky_number(extracted_digits)

    print(f"{lucky_number}")

if __name__ == "__main__":
    main()

